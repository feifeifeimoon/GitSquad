# GitSquad — local development configuration.
# Copy this file to .env and fill in the required values.


# GITSQUAD_JWT_SECRET=change-me-in-production
# GITSQUAD_FRONTEND_URL=http://localhost:3000

# Server
GITSQUAD_ENV=development
GITSQUAD_HTTP_ADDR=:8080
GITSQUAD_DATABASE_URL=postgres://gitsquad:gitsquad@localhost:5432/gitsquad?sslmode=disable

# Google OAuth (required — register at https://console.cloud.google.com/apis/credentials)
GITSQUAD_GOOGLE_CLIENT_ID=
GITSQUAD_GOOGLE_CLIENT_SECRET=
# GITSQUAD_GOOGLE_CALLBACK_URL=http://localhost:8080/api/v1/auth/google/callback

# GitHub App (required — register at https://github.com/settings/apps/new)
# GITSQUAD_GITHUB_APP_ID=
# GITSQUAD_GITHUB_APP_PRIVATE_KEY=
# GITSQUAD_GITHUB_APP_NAME=gitsquad
# GITSQUAD_GITHUB_WEBHOOK_SECRET=

# OpenTelemetry (optional). Tracing stays off unless an OTLP endpoint is set.
# The exporter also reads OTEL_EXPORTER_OTLP_TIMEOUT and related OTEL_* vars.
# OTEL_SERVICE_NAME=gitsquad-server
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-ap-southeast-1.grafana.net/otlp
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64 instance-id:token>
# Share of GETs traced; writes and webhooks are always traced. Default 0.1.
# GITSQUAD_OTEL_SAMPLE_RATIO=0.1
